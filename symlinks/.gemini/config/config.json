{
  "userSettings": {
    "autoExecutionPolicy": "CASCADE_COMMANDS_AUTO_EXECUTION_SANDBOX",
    "customThemeSeedsDark": {
      "background": "#000000",
      "primary": "#FF0000"
    },
    "customThemeSeedsLight": {
      "background": "#F9F9F9",
      "foregroundOverride": "#101010",
      "primary": "#007acc"
    },
    "enableTerminalSandbox": true,
    "globalPermissionGrants": {
      "allow": [
        "command(gh repo view)",
        "command(gh repo gitignore)",
        "command(gh repo license)",
        "command(gh repo read-dir)",
        "command(gh repo read-file)",
        "command(gh gist view)",
        "command(gh gist list)",
        "command(gh pr export)",
        "command(gh pr view)",
        "command(gh pr list)",
        "command(gh pr status)",
        "command(gh pr checkout)",
        "command(gh pr checks)",
        "command(gh pr diff)",
        "command(gh issue export)",
        "command(gh issue view)",
        "command(gh issue list)",
        "command(gh issue status)",
        "command(gh run)",
        "command(gh workflow)",
        "command(gh search)",
        "command(gh licenses)",
        "command(gh ruleset)",
        "command(gh status)",
        "command(gh browse)",
        "command(git diff)",
        "command(git show)",
        "command(git status)",
        "command(git log)",
        "command(nix)",
        "command(nix-shell)",
        "command(nix-build)",
        "command(nix-instantiate)",
        "command(nix-prefetch-url)",
        "command(nix-info)",
        "command(nix-collect-garbage)",
        "command(nix-hash)",
        "command(nix-store)",
        "command(nix-copy-closure)",
        "command(nixos-help)",
        "command(nixos-option)",
        "command(nixos-version)",
        "command(nixfmt)",
        "command(nixfmt-tree)",
        "command(treefmt)",
        "command(nh)",
        "command(./tests/test_scenarios.sh)",
        "read_url(raw.githubusercontent.com)",
        "read_url(github.com)",
        "read_url(mermaid.ai)",
        "read_url(mermaid.js.org)",
        "read_url(codeberg.org)",
        "command(lsblk)",
        "command(git fixpush)",
        "command(git ls-files)"
      ]
    },
    "nonWorkspaceFileAccessPolicy": "AGENT_SETTING_POLICY_ASK",
    "remoteControlEnabled": true,
    "remoteControlHostname": "malix-legion-nixos_hub",
    "themeMode": "THEME_MODE_INHERIT"
  }
}